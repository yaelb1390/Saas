APP_NAME="BM Business OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_TIMEZONE=America/Santo_Domingo
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. En local vía Docker: host=postgres. En prod: apuntar al host de Supabase.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bmbusinessos
DB_USERNAME=bmos
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo ---
# En desarrollo `log` basta: los correos se escriben en storage/logs y se leen desde ahí.
#
# EN PRODUCCIÓN HAY QUE PONER UN TRANSPORTE REAL. Con `log` el sistema no avisa de nada: se
# comporta como si hubiera enviado y el correo acaba en los registros del servidor. Es lo que le
# pasaba a este proyecto —ninguna variable MAIL_* configurada— y por eso no llegaba ni el enlace
# para recuperar la contraseña ni la bienvenida ni el aviso de vencimiento.
#
# Ejemplo con Brevo (SMTP, sin instalar nada):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_SCHEME=smtp        # «smtp» en el puerto 587 (el cifrado se negocia); «smtps» solo en el 465
#   MAIL_USERNAME=<usuario que da Brevo, acaba en @smtp-brevo.com>
#   MAIL_PASSWORD=<la clave SMTP, NO la contraseña de la cuenta>
#
# MAIL_FROM_ADDRESS debe ser un remitente VERIFICADO en el proveedor. Con el valor de ejemplo, o
# con un dominio sin verificar, los correos se rechazan o van a la carpeta de no deseados.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Cloudflare R2 (storage S3-compatible) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto

# --- n8n (automatización) ---
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_SECRET=

# --- Evolution API (WhatsApp) ---
# Vacío = modo registro (no se envía nada, solo se guarda la conversación).
# Para operar en vivo: docker compose --profile whatsapp up -d evolution
#   EVOLUTION_BASE_URL=http://evolution:8080   (nombre del servicio en la red de Docker)
#   EVOLUTION_API_KEY debe coincidir con AUTHENTICATION_API_KEY del contenedor.
# El nombre de la instancia es el slug de la empresa activa (una línea por empresa);
# EVOLUTION_INSTANCE solo se usa como reserva si no hay empresa activa.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_URL=http://web/webhooks/evolution

# --- Polar (cobro de las suscripciones) ---
# Secreto del endpoint de webhook, que se genera al crearlo en el panel de Polar. NO es el token de
# la API: son credenciales distintas. Sin este valor, el webhook rechaza todos los avisos (503):
# la firma es lo único que impide que cualquiera se active un plan con un POST.
POLAR_WEBHOOK_SECRET=

# Idioma de la pantalla de pago («es» para español). VACÍO por defecto, y no por descuido: la
# localización del checkout es una función en BETA que hay que habilitar antes en la organización de
# Polar. Si se manda el idioma sin habilitarla y Polar rechazara el parámetro, dejarían de funcionar
# TODOS los cobros. Se enciende cuando la beta esté activa, no antes.
#
# Durante la beta, Polar traduce la pantalla de pago pero NO los mensajes de error ni los correos de
# recibo, que siguen llegando en inglés.
POLAR_LOCALE=

# --- IA ---
# YA NO HACE FALTA TOCAR ESTO. La clave se pega desde el panel del operador, en
# «IA de la plataforma», y se guarda cifrada en la base. Estas variables quedan solo como
# respaldo para instalaciones que ya las tuvieran puestas: si hay clave en la base, manda esa.
#
# OJO con el proveedor: Anthropic (Claude) NO genera embeddings, así que con él el asistente no
# puede indexar ni buscar documentos. Antes este fichero traía `AI_DEFAULT_PROVIDER=claude` por
# omisión, y con una clave válida cada pregunta devolvía un error 500.
#
# Valores admitidos: gemini, openai, anthropic (o su sinónimo claude) y local.
# Gemini es el recomendado: hace chat Y embeddings, y su capa gratuita cubre a un negocio pequeño.
AI_DEFAULT_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- DGII (facturación fiscal RD) ---
DGII_ENVIRONMENT=testing
DGII_CERT_PATH=
DGII_CERT_PASSWORD=

# --- Inicio de sesión con Google (Socialite) ---
# Credenciales del cliente OAuth de Google Cloud Console. Vacío = el botón «Continuar con Google»
# avisa de que no está configurado, sin romper el login normal.
# GOOGLE_REDIRECT_URI debe coincidir EXACTO con un «URI de redirección autorizado» del cliente;
# cualquier diferencia (http/https, puerto, barra final) da redirect_uri_mismatch.
# Al regenerar el secreto en la consola, el anterior deja de valer de inmediato: hay que
# actualizarlo aquí y ejecutar `php artisan config:clear`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
